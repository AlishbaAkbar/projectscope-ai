# ===============================================
# ProjectScope AI Environment Configuration
# ===============================================

# Application Environment (development, testing, production)
APP_ENV=development
DEBUG=true

# Database Connection (SQLite by default, PostgreSQL for production)
DATABASE_URL=sqlite:///./projectscope.db
# Example for PostgreSQL:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/projectscope_db

# AI Provider Configuration
# Supported providers: "mock", "gemini", "openai"
# "mock" runs locally without any API keys or network connection (ideal for testing and offline development)
AI_PROVIDER=mock

# AI Provider Credentials (Required when AI_PROVIDER is "gemini" or "openai")
AI_PROVIDER_API_KEY=your_api_key_here
AI_MODEL=gemini-1.5-flash
# For OpenAI:
# AI_PROVIDER=openai
# AI_PROVIDER_API_KEY=sk-...
# AI_MODEL=gpt-4o-mini

# AI Execution Parameters
AI_MAX_RETRIES=2
AI_TIMEOUT_SECONDS=30.0

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8000","http://127.0.0.1:8000"]

# Frontend Next.js Public URL
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
