# ============================================
# PROJECTSCOPE AI — PRODUCTION ENVIRONMENT
# ============================================
# Copy this file to .env.prod and fill in real values
# NEVER commit .env.prod to version control

# --------------------------------------------
# DOMAIN & TLS
# --------------------------------------------
DOMAIN=yourdomain.com

# --------------------------------------------
# POSTGRESQL
# --------------------------------------------
POSTGRES_USER=projectscope
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=projectscope

# --------------------------------------------
# REDIS
# --------------------------------------------
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD

# --------------------------------------------
# JWT
# --------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=CHANGE_ME_64_CHAR_RANDOM_STRING

# --------------------------------------------
# AI PROVIDERS
# --------------------------------------------
AI_PROVIDER=gemini
AI_PROVIDER_API_KEY=your_gemini_api_key_here
AI_MODEL=gemini-flash-latest

# --------------------------------------------
# OPTIONAL: OpenTelemetry / Monitoring
# --------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=projectscope-backend